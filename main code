import json
from urllib.error import HTTPError
from urllib.request import urlopen

print("my crypto tracker")

holdings = {"solana": 3, "ethereum": 1, "ripple": 2, "binancecoin": 4}
portfolio_values = {coin: amount for coin, amount in holdings.items()}
total_value = sum(portfolio_values.values())

def get_prices(coins):
    prices = {}
    for coin in coins:
        url = f"https://api.coingecko.com/api/v3/simple/price?ids={coin}&vs_currencies=usd"
        try:
            with urlopen(url, timeout=15) as response:
                data = json.load(response)

            coin_data = data.get(coin, {})
            price = coin_data.get("usd")
            if price is None:
                print(f"coin {coin} price not found in API response")
                continue

            prices[coin] = price
        except TimeoutError:
            print(f"timeout error occured when trying to get price for {coin}")
        except HTTPError as error:
            if error.code == 404:
                print(f"coin {coin} webpage not found")
            else:
                print(f"HTTP error {error.code} for {coin}")
        except Exception as exc:
            print(f"failed to get price for {coin}: {exc}")
    return prices


def format_report(values, total_value):
    print()
    print("Portfolio summary")
    print("------------------")
    for coin, value in values.items():
        print(f"{coin} value: ${value:.2f}")
    print(f"total portfolio value: ${total_value:.2f}")


prices = get_prices(holdings.keys())
portfolio_values = {}
for coin, amount in holdings.items():
    price = prices.get(coin)
    if price is None:
        print(f"skipping {coin} because price is unavailable")
        continue
    portfolio_values[coin] = amount * price

total_value = sum(portfolio_values.values())


if __name__ == "__main__":
    format_report(portfolio_values, total_value)
