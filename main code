import requests

holdings = {
    "solana": 3,
    "ethereum": 1,
    "ripple": 2,
    "binancecoin": 4,
}

url = "https://api.coingecko.com/api/v3/simple/price"
parameters = {
    "ids": ",".join(holdings.keys()),
    "vs_currencies": "usd",
}

try:
    response = requests.get(url, params=parameters, timeout=15)
    response.raise_for_status()
    prices = response.json()
except requests.exceptions.RequestException as error:
    print(f"Could not get prices from CoinGecko: {error}")
    raise SystemExit(1)
except ValueError as error:
    print(f"CoinGecko returned invalid data: {error}")
    raise SystemExit(1)

total_value = 0
all_prices_found = True

print("Crypto portfolio (USD)")
print("----------------------")

for coin, amount in holdings.items():
    if coin not in prices or "usd" not in prices[coin]:
        print(f"{coin}: price unavailable")
        all_prices_found = False
        continue

    price = prices[coin]["usd"]
    value = amount * price
    total_value += value
    print(f"{coin}: {amount} held at ${price:,.2f} each = ${value:,.2f}")

if all_prices_found:
    print(f"Total value: ${total_value:,.2f}")
else:
    print(f"Partial total: ${total_value:,.2f} (some prices unavailable)")
